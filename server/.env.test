PORT=3001
NODE_ENV=test

# Separate database so tests never touch dev data. Assumes a local MongoDB
# is reachable at this address (matching the dev setup in .env).
MONGO_URI=mongodb://localhost:27017/care-continuum-test

# Not a real secret -- fine to commit, used only for signing test tokens.
JWT_SECRET=test-only-jwt-secret-do-not-use-in-production
JWT_EXPIRES_IN=1h
