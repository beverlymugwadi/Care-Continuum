PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/care-continuum

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS: the frontend's origin(s), comma-separated if more than one
CLIENT_ORIGIN=http://localhost:5173

# SMS (Twilio) -- optional. Leave blank to keep the console-log stub (see
# src/services/smsProvider.js), useful for local dev without a real SMS
# account. Fill these in from your Twilio Console (console.twilio.com) to
# send real texts.
#
# Rwanda: TWILIO_PHONE_NUMBER (a Twilio number) works out of the box.
# Zimbabwe: Twilio recommends an alphanumeric sender ID for reliable
# delivery there -- set that up as a Messaging Service in the Twilio
# Console and use TWILIO_MESSAGING_SERVICE_SID instead of
# TWILIO_PHONE_NUMBER (it takes priority when both are set).
#
# On a free trial account, Twilio can only send to phone numbers you've
# verified in the Console (up to 5), and messages carry a
# "Sent from a Twilio trial account" prefix until you add a payment method.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
